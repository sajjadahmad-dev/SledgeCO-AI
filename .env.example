# ============================================================
# SledgeCO-AI Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- LLM Provider Configuration ---
# Gemini API key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API key (required when LLM_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# LLM provider: "gemini", "groq", or "mock"
# Use "mock" for development/testing without API costs
LLM_PROVIDER=mock

# --- Pipeline Configuration ---
# Maximum file size in MB (reject larger files)
MAX_FILE_SIZE_MB=50

# Minimum characters per page to consider it "has text" (vs scanned)
MIN_TEXT_CHARS_PER_PAGE=50

# DPI for rendering scanned PDF pages as images
SCAN_RENDER_DPI=300

# Optional explicit Tesseract executable path on Windows
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Confidence Configuration ---
# Enable multi-run LLM extraction for agreement-based confidence
# WARNING: Multiplies API costs by NUM_EXTRACTION_RUNS
ENABLE_MULTI_RUN=false
NUM_EXTRACTION_RUNS=3

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# SECURITY: Never set to true in production
# When true, document text may appear in debug logs
LOG_DOCUMENT_TEXT=false
